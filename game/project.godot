config_version=5
[application]
config/name="远岸钓记"
config/version="1.3.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://assets/ui/icons/badge.png"
config/description="离线 3D 河湖与远洋钓鱼、自然图鉴"
[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/dpi/allow_hidpi=true
[rendering]
anti_aliasing/quality/msaa_3d=2
rendering_device/driver.android="vulkan"
rendering_device/fallback_to_opengl3=false
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.04, 0.13, 0.16, 1)
[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
[audio]
default_bus_layout="res://default_bus_layout.tres"
[gui]
theme/default_font_multichannel_signed_distance_field=false
[debug]
gdscript/warnings/untyped_declaration=0
