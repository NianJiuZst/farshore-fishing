config_version=5
[application]
config/name="远岸钓记"
config/version="1.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/description="离线的手绘钓鱼旅行与自然图鉴"
[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/dpi/allow_hidpi=true
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.04, 0.13, 0.16, 1)
[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
[audio]
default_bus_layout="res://default_bus_layout.tres"
[gui]
theme/default_font_multichannel_signed_distance_field=false
[debug]
gdscript/warnings/untyped_declaration=0
